# Groq (primary provider — free tier available)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=qwen/qwen3.6-27b
GROQ_SECONDARY_MODEL=openai/gpt-oss-120b

# Groq free-tier TPM limits (optional, set to 0 for unlimited)
GROQ_QWEN_TPM=8000
GROQ_GPT_OSS_TPM=8000

# Google Gemini (fallback — free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TPM=

# Pushover notifications (for recording user details & unknown questions)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional: custom allowed origin (defaults to https://portfolio-xdk9.vercel.app)
ALLOWED_ORIGIN=